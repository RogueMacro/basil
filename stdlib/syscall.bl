// Syscall definitions. Maps directly to Apple Silicon syscalls.

fn exit(status: i64);

fn read(fd: i64, buf: *char, nbytes: i64) -> i64;

fn write(fd: i64, buf: *char, nbytes: i64) -> i64;

fn open(filename: *char, flags: i64) -> i64;

fn close(fd: i64) -> i64;

fn lseek(fd: i64, offset: i64, whence: i64) -> i64;

fn mmap(addr: *(), len: i64, prot: i64, flags: i64, file_desc: i64, offset: i64) -> *i8;
